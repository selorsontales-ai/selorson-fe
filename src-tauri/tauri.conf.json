{
  "$schema": "https://schema.tauri.app/2/tauri.schema.json",
  "productName": "Selorson",
  "version": "0.1.1",
  "identifier": "com.selorson.app",
  "build": {
    "frontendDist": "../build",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev:desktop",
    "beforeBuildCommand": "npm run build:desktop && npm run sidecar:runtime"
  },
  "app": {
    "windows": [
      {
        "title": "Selorson",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "sidecar-runtime/node.exe",
      "sidecar-runtime/runtime.json",
      "sidecar/runner.mjs",
      "sidecar/artifact-runner.mjs",
      "sidecar/package.json",
      "sidecar/node_modules/**/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
