{
	"name": "frontend-v3",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"dev:mobile": "cross-env VITE_BUILD_TARGET=mobile vite dev --host",
		"dev:desktop": "cross-env VITE_BUILD_TARGET=desktop vite dev",
		"build": "vite build",
		"build:mobile": "node scripts/mobile-build.cjs",
		"build:desktop": "cross-env BUILD_TARGET=desktop vite build --mode desktop",
		"build:web": "vite build",
		"tauri": "tauri",
		"sidecar:install": "npm ci --prefix src-tauri/sidecar",
		"sidecar:runtime": "node src-tauri/scripts/prepare-sidecar-runtime.mjs",
		"sidecar:test": "npm test --prefix src-tauri/sidecar",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"devDependencies": {
		"@capacitor/android": "^8.3.4",
		"@capacitor/assets": "^3.0.5",
		"@capacitor/cli": "^8.3.4",
		"@capacitor/core": "^8.3.4",
		"@inlang/paraglide-js": "^2.18.0",
		"@sentry/sveltekit": "^10.53.1",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-cloudflare": "^7.2.8",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.57.0",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tauri-apps/cli": "^2.0.0-rc.18",
		"@types/cropperjs": "^1.1.5",
		"@types/node": "^25.6.0",
		"@types/qrcode": "^1.5.6",
		"cross-env": "^10.1.0",
		"svelte": "^5.55.2",
		"svelte-check": "^4.4.6",
		"typescript": "^6.0.2",
		"vite": "^8.0.7"
	},
	"dependencies": {
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.2.4",
		"@tauri-apps/api": "^2.11.0",
		"cropperjs": "^1.6.2",
		"qrcode": "^1.5.4",
		"tailwindcss": "^4.2.4",
		"vidstack": "^1.12.13"
	}
}
