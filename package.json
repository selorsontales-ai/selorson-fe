{
  "name": "frontend-v3",
  "private": true,
  "version": "0.1.17",
  "type": "module",
  "scripts": {
    "dev": "npm run dev:web:user",
    "dev:web:user": "node scripts/flavor-dev.cjs web user",
    "dev:web:admin": "node scripts/flavor-dev.cjs web admin",
    "dev:mobile": "npm run dev:mobile:admin",
    "dev:mobile:admin": "node scripts/flavor-dev.cjs android admin",
    "dev:mobile:user": "node scripts/flavor-dev.cjs android user",
    "dev:desktop": "npm run dev:desktop:admin",
    "dev:desktop:admin": "node scripts/flavor-dev.cjs desktop admin",
    "dev:desktop:user": "node scripts/flavor-dev.cjs desktop user",
    "build": "npm run build:web:user",
    "build:mobile": "npm run build:mobile:admin",
    "build:mobile:admin": "node scripts/mobile-build.cjs admin",
    "build:mobile:user": "node scripts/mobile-build.cjs user",
    "android:sync:admin": "node scripts/android-sync-flavor.cjs admin",
    "android:sync:user": "node scripts/android-sync-flavor.cjs user",
    "build:desktop": "npm run build:desktop:admin",
    "build:desktop:admin": "node scripts/desktop-build.cjs admin",
    "build:desktop:user": "node scripts/desktop-build.cjs user",
    "tauri:build:admin": "cross-env SELORSON_APP_FLAVOR=desktop-admin VITE_APP_FLAVOR=desktop-admin tauri build -- --features admin-backend",
    "tauri:build:user": "cross-env SELORSON_APP_FLAVOR=desktop-user VITE_APP_FLAVOR=desktop-user tauri build --config src-tauri/tauri.user.conf.json -- --no-default-features",
    "build:web": "npm run build:web:user",
    "build:web:user": "node scripts/web-build.cjs user",
    "build:web:admin": "node scripts/web-build.cjs admin",
    "tauri": "tauri",
    "preview": "vite preview",
    "paraglide:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide",
    "prepare": "npm run paraglide:compile && svelte-kit sync",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test:runtime": "node --test tests/*.test.mjs",
    "test:desktop:e2e": "node --test tests/desktop-navigation.e2e.mjs",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
  },
  "devDependencies": {
    "@capacitor/android": "^8.3.4",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.3.4",
    "@capacitor/core": "^8.3.4",
    "@inlang/paraglide-js": "^2.18.0",
    "@sentry/sveltekit": "^10.53.1",
    "@sveltejs/adapter-auto": "^7.0.1",
    "@sveltejs/adapter-cloudflare": "^7.2.8",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.57.0",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@tauri-apps/cli": "^2.11.0",
    "@types/cropperjs": "^1.1.5",
    "@types/node": "^25.6.0",
    "@types/qrcode": "^1.5.6",
    "cross-env": "^10.1.0",
    "selenium-webdriver": "^4.46.0",
    "svelte": "^5.55.2",
    "svelte-check": "^4.4.6",
    "typescript": "^6.0.2",
    "vite": "^8.0.7"
  },
  "dependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.2.4",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@threlte/core": "^8.5.16",
    "@threlte/extras": "^9.21.0",
    "cropperjs": "^1.6.2",
    "qrcode": "^1.5.4",
    "tailwindcss": "^4.2.4",
    "three": "^0.185.1"
  }
}
